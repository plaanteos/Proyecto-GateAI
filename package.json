{
  "name": "uniontech",
  "version": "1.0.0",
  "main": "src/server-complete.js",
  "description": "Sistema completo de control de accesos empresariales con WhatsApp/Email",
  "scripts": {
    "start": "node src/server-complete.js",
    "dev": "nodemon src/server-complete.js",
    "dev:debug": "nodemon --inspect src/server-complete.js",
    "production": "NODE_ENV=production node src/server-complete.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --detectOpenHandles",
    "test:e2e": "cross-env NODE_ENV=test jest --testPathPattern=e2e --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=unit --runInBand",
    "docs:generate": "node scripts/generate-docs.js",
    "db:optimize": "node scripts/optimize-database.js",
    "metrics:report": "node scripts/generate-metrics-report.js",
    "build": "echo 'Build completed successfully'",
    "validate": "node scripts/validate-system.js",
    "legacy:start": "node src/server.js",
    "legacy:dev": "nodemon src/server.js",
    "legacy:debug": "nodemon src/server-debug.js",
    "legacy:simple": "nodemon src/server-dev.js",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:reset": "npx prisma migrate reset",
    "initialize": "node initialize.js",
    "health": "curl -X GET http://localhost:3000/health",
    "production:setup": "npm install --production && npx prisma generate && npx prisma migrate deploy",
    "chatbot": "node chatbot-whatsapp.js",
    "chatbot:dev": "nodemon chatbot-whatsapp.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:monitor": "pm2 monit",
    "pm2:logs": "pm2 logs",
    "monitor:health": "node monitor.js health",
    "monitor:report": "node monitor.js report",
    "monitor:maintenance": "node monitor.js maintenance",
    "backup:full": "node backup.js full",
    "backup:database": "node backup.js database",
    "backup:files": "node backup.js files",
    "backup:verify": "node backup.js verify",
    "backup:list": "node backup.js list",
    "deploy:staging": "pm2 deploy ecosystem.config.js staging",
    "deploy:production": "pm2 deploy ecosystem.config.js production"
  },
  "keywords": [
    "control-accesos",
    "qr-codes",
    "whatsapp-notifications",
    "email-automation",
    "visitor-management",
    "security-system",
    "uniontech"
  ],
  "author": "UnionTech Development Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "path-to-regexp": "^6.2.1",
    "prisma": "^6.16.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "nodemailer": "^6.10.1",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^5.8.0",
    "uuid": "^11.1.0",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.13.0",
    "@types/node": "^24.3.0",
    "aws-sdk": "^2.1691.0",
    "cross-env": "^7.0.3",
    "firebase-admin": "^12.6.0",
    "ioredis": "^5.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/database.js",
      "!src/server-complete.js",
      "!src/app.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 30000,
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true
  }
}
