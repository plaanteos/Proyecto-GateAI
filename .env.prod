# Configuración de Producción - UnionTech
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# JWT Security - CAMBIAR EN PRODUCCIÓN
JWT_SECRET=uniontech_super_secret_key_production_2025_change_this_in_production
JWT_EXPIRE=24h

# Base de datos (descomentar cuando uses DB real)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/uniontech_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=uniontech_db
# DB_USER=uniontech_user
# DB_PASS=tu_password_seguro

# Email para recuperación de contraseñas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@tuempresa.com
# SMTP_PASS=tu_password_smtp

# Configuración de seguridad
CORS_ORIGIN=*
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=24h
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Configuración de archivos
UPLOAD_DIR=./data/documents
FACES_DIR=./data/faces
MAX_FILE_SIZE=10485760

# Logs
LOG_LEVEL=info
LOG_FILE_PATH=./logs/
AUDIT_LOG_ENABLED=true
CRITICAL_LOG_ENABLED=true

# Features flags
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RECOVERY=true
ENABLE_FACIAL_RECOGNITION=true
ENABLE_QR_ACCESS=true

# Performance
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT=30000

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# SSL/HTTPS (para producción)
# SSL_KEY_PATH=/path/to/private-key.pem
# SSL_CERT_PATH=/path/to/certificate.pem
# FORCE_HTTPS=true
