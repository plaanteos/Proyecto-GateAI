# UnionTech Access Control System - Configuración
# Copia este archivo como .env y completa los valores

# ──────────────────────────────────────────────
# SERVIDOR
# ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
API_VERSION=v1

# ──────────────────────────────────────────────
# SEGURIDAD — OBLIGATORIO cambiar en producción
# ──────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=540cc0ba0498416152b39fdf6c528d1840e104a66b8a5c73df5e43d827da6e4e753246c5ea0e20dc375a76b45cc3319f1126b68a8877ef5469f08494c9440064
JWT_EXPIRATION=8h

# ──────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL
# ──────────────────────────────────────────────
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# Producción (Railway, Render, Supabase, etc.):
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/uniontech_db"

# Desarrollo local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uniontech_db"

# Para saltar la BD y usar modo fallback (solo desarrollo/demo):
# SKIP_DB_CONNECTION=true
# DATABASE_MODE=fallback

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
CORS_ORIGINS=https://tudominio.com,https://app.tudominio.com
ALLOWED_ORIGINS=https://tudominio.com

# ──────────────────────────────────────────────
# REDIS (caché y sesiones)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────
# WHATSAPP BOT LOCAL
# ──────────────────────────────────────────────
WHATSAPP_BOT_URL=http://localhost:3002
WHATSAPP_BOT_PORT=3002

# ──────────────────────────────────────────────
# TWILIO (fallback WhatsApp/SMS)
# ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ──────────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid
# Opciones: sendgrid | gmail | outlook | smtp

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@tudominio.com
FROM_NAME=UnionTech Security System

# Gmail (si EMAIL_PROVIDER=gmail)
# GMAIL_USER=tu@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP genérico (si EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@tudominio.com
# SMTP_PASSWORD=tu_password

# ──────────────────────────────────────────────
# ALMACENAMIENTO (opcional)
# ──────────────────────────────────────────────
STORAGE_TYPE=local
# Opciones: local | gcs | s3

# Google Cloud Storage (si STORAGE_TYPE=gcs)
# GCS_PROJECT_ID=tu-proyecto-gcp
# GCS_KEY_FILE=/ruta/a/credenciales.json
# GCS_BUCKET_NAME=uniontech-uploads

# Amazon S3 (si STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=uniontech-uploads

# ──────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ──────────────────────────────────────────────
# CARGA DE ARCHIVOS
# ──────────────────────────────────────────────
UPLOAD_MAX_SIZE=10mb
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# ──────────────────────────────────────────────
# CÓDIGOS QR
# ──────────────────────────────────────────────
QR_EXPIRATION_HOURS=24
QR_CODE_SIZE=256
QR_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_PARA_QR

# ──────────────────────────────────────────────
# SEGURIDAD DE CUENTAS
# ──────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT_HOURS=24

# ──────────────────────────────────────────────
# WEBSOCKET
# ──────────────────────────────────────────────
WEBSOCKET_ORIGINS=https://tudominio.com

# ──────────────────────────────────────────────
# MANTENIMIENTO
# ──────────────────────────────────────────────
INVITATION_CLEANUP_INTERVAL_HOURS=1
LOG_CLEANUP_DAYS=30
BACKUP_RETENTION_DAYS=90

# ──────────────────────────────────────────────
# MONITOREO
# ──────────────────────────────────────────────
ALERT_EMAIL_RECIPIENTS=admin@tudominio.com
PERFORMANCE_MONITORING=true
QR_CODE_ERROR_CORRECTION=M

# Security Headers
SECURITY_HEADERS_ENABLED=true
HELMET_ENABLED=true
CSRF_PROTECTION=true

# Session Configuration
SESSION_SECRET=uniontech_session_secret_2025
SESSION_TIMEOUT=24h
