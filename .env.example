# UnionTech Access Control System - Configuration
# Professional Edition v2.0.0 - Complete Implementation

# Server Configuration
PORT=3000
HOST=localhost

# Security Configuration
JWT_SECRET=uniontech_professional_secret_key_2025_secure
JWT_EXPIRATION=8h

# CORS Configuration
CORS_ORIGIN=http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Environment
NODE_ENV=development
API_VERSION=v1

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW=15min
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration
DATABASE_URL="sqlserver://localhost:1433;database=uniontech;user=sa;password=your_password;encrypt=false"

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@uniontech.com
FROM_NAME=UnionTech Security System

# File Upload Configuration
UPLOAD_MAX_SIZE=10mb
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# System Configuration
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30min
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=24h

# WebSocket Configuration
WEBSOCKET_ORIGINS=*
WEBSOCKET_PING_INTERVAL=25s
WEBSOCKET_PING_TIMEOUT=5s

# Maintenance Settings
INVITATION_CLEANUP_INTERVAL=1h
LOG_CLEANUP_DAYS=30
BACKUP_RETENTION_DAYS=90

# QR Code Configuration
QR_CODE_SIZE=256
QR_CODE_ERROR_CORRECTION=M
QR_EXPIRATION_HOURS=24

# Biometric Configuration (if enabled)
FACE_RECOGNITION_THRESHOLD=0.6
DOCUMENT_SCANNER_ENABLED=true

# Monitoring and Alerts
ALERT_EMAIL_RECIPIENTS=admin@uniontech.com
PERFORMANCE_MONITORING=true
ERROR_REPORTING=true
# DB_PORT=5432
# DB_NAME=uniontech_access
# DB_USER=uniontech
# DB_PASSWORD=secure_password

# Notification Services (for future integration)
# WHATSAPP_API_URL=https://api.whatsapp.com
# WHATSAPP_API_KEY=your_api_key
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=noreply@uniontech.com
# EMAIL_PASSWORD=email_password

# File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# QR Code Configuration
QR_CODE_SIZE=256
QR_CODE_FORMAT=PNG
QR_CODE_ERROR_CORRECTION=M

# Security Headers
SECURITY_HEADERS_ENABLED=true
HELMET_ENABLED=true
CSRF_PROTECTION=true

# Session Configuration
SESSION_SECRET=uniontech_session_secret_2025
SESSION_TIMEOUT=24h
