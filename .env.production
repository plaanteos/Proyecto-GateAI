# Configuración de Base de Datos - UnionTech
# Variables para conexión con SQL Server

# === CONFIGURACIÓN DE BASE DE DATOS ===
DATABASE_TYPE=sqlserver
DATABASE_SERVER=localhost
DATABASE_NAME=UnionTechDB
DATABASE_USERNAME=tu_usuario
DATABASE_PASSWORD=tu_password
DATABASE_PORT=1433
DATABASE_ENCRYPT=true
DATABASE_TRUST_SERVER_CERTIFICATE=true

# === CONFIGURACIÓN DE AUTENTICACIÓN ===
JWT_SECRET=tu_clave_secreta_super_segura_2024
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# === CONFIGURACIÓN DE SERVIDOR ===
API_PORT=3000
FRONTEND_PORT=8080
NODE_ENV=development

# === CONFIGURACIÓN DE VALIDACIÓN BIOMÉTRICA ===
FACIAL_RECOGNITION_API_KEY=tu_api_key_facial
FACIAL_RECOGNITION_PROVIDER=azure_cognitive_services
# Alternativas: aws_rekognition, google_cloud_vision

# === CONFIGURACIÓN DE NOTIFICACIONES ===
WHATSAPP_API_TOKEN=tu_token_whatsapp
WHATSAPP_PHONE_NUMBER=+123456789
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_email

# === CONFIGURACIÓN DE ALMACENAMIENTO ===
STORAGE_TYPE=local
# Alternativas: azure_blob, aws_s3, google_cloud_storage
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf

# === CONFIGURACIÓN DE SEGURIDAD ===
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT=30
CORS_ORIGIN=http://localhost:8080

# === CONFIGURACIÓN DE LOGGING ===
LOG_LEVEL=debug
LOG_FILE=./logs/uniontech.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5
