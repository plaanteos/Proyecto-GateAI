{
  "name": "uniontech-security-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema profesional de gestión de visitantes y control de acceso",
  "author": "UnionTech Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "react-native clean",
    "reset-cache": "react-native start --reset-cache",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace UnionTechSecurity.xcworkspace -scheme UnionTechSecurity archive",
    "postinstall": "npx react-native setup-ios-permissions && npx pod-install ios"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "react-native-paper": "^5.11.1",
    "react-native-vector-icons": "^10.0.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-flash-message": "^0.4.2",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.27.0",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-reanimated": "^3.5.4",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "react-native-touch-id": "^4.4.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-keychain": "^8.1.3",
    "react-native-device-info": "^10.11.0",
    "react-native-permissions": "^3.10.1",
    "react-native-camera": "^4.2.1",
    "react-native-image-picker": "^7.0.3",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-svg": "^13.14.0",
    "react-native-charts-wrapper": "^0.5.11",
    "react-native-date-picker": "^4.3.3",
    "react-native-modal": "^13.0.1",
    "react-native-animatable": "^1.3.3",
    "react-native-super-grid": "^4.9.1",
    "react-native-swipe-gestures": "^1.0.5",
    "react-native-orientation-locker": "^1.6.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-network-info": "^5.2.1",
    "@react-native-community/netinfo": "^9.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-share": "^9.4.1",
    "react-native-print": "^0.8.0",
    "react-native-document-picker": "^9.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/runtime": "^7.23.4",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.2.37",
    "@types/react-test-renderer": "^18.0.5",
    "babel-jest": "^29.7.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.76.8",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "react-native"
  },
  "react-native": {
    "zlib": "react-native-level-fs",
    "fs": "react-native-level-fs",
    "path": "react-native-path"
  },
  "rnpm": {
    "assets": [
      "./assets/fonts/"
    ]
  }
}
