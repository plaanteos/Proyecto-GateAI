# UnionTech Security Mobile App - Environment Configuration

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend Server URL
BACKEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3000/api

# API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Biometric Authentication
BIOMETRIC_ENABLED=true
BIOMETRIC_FALLBACK=true
BIOMETRIC_PROMPT_TITLE="UnionTech Security"
BIOMETRIC_PROMPT_SUBTITLE="Autentícate para acceder"
BIOMETRIC_PROMPT_DESCRIPTION="Usa tu huella digital o Face ID"

# =============================================================================
# SECURITY
# =============================================================================

# Encryption
ENCRYPTION_KEY=your-encryption-key-here
KEYCHAIN_SERVICE="uniontech-security"
KEYSTORE_ALIAS="uniontech-keystore"

# SSL/TLS
SSL_PINNING_ENABLED=true
CERTIFICATE_PINNING=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG_MODE=true
CONSOLE_LOGS=true
NETWORK_LOGS=true

# Development Tools
REACTOTRON_ENABLED=true
FLIPPER_ENABLED=true
DEV_MENU_ENABLED=true

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Production flags (set to false for production)
# ENVIRONMENT=production
# DEBUG_MODE=false
# CONSOLE_LOGS=false
# NETWORK_LOGS=false
# REACTOTRON_ENABLED=false
# FLIPPER_ENABLED=false
# DEV_MENU_ENABLED=false

# =============================================================================
# FEATURES FLAGS
# =============================================================================

# Feature toggles
BIOMETRIC_AUTH_ENABLED=true
CAMERA_ENABLED=true
QR_SCANNER_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
OFFLINE_MODE_ENABLED=true
WEBSOCKET_ENABLED=true

# Experimental features
FACE_RECOGNITION_ENABLED=false
VOICE_COMMANDS_ENABLED=false
AR_SCANNER_ENABLED=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Firebase (for push notifications)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_TRACKING_ID=your-analytics-id

# Crash Reporting
CRASHLYTICS_ENABLED=true
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Local Storage
STORAGE_ENCRYPTION_ENABLED=true
CACHE_SIZE_LIMIT=100MB
CACHE_TTL=86400000

# Image Storage
IMAGE_CACHE_SIZE=50MB
IMAGE_COMPRESSION_QUALITY=0.8
IMAGE_MAX_WIDTH=1024
IMAGE_MAX_HEIGHT=1024

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Timeouts
CONNECTION_TIMEOUT=10000
READ_TIMEOUT=30000
WRITE_TIMEOUT=30000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MULTIPLIER=2
INITIAL_RETRY_DELAY=1000

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================

# Theme
DEFAULT_THEME=light
DARK_MODE_AVAILABLE=true
SYSTEM_THEME_FOLLOWS=true

# Animations
ANIMATIONS_ENABLED=true
ANIMATION_DURATION=300
REDUCED_MOTION_RESPECT=true

# Accessibility
ACCESSIBILITY_ENABLED=true
FONT_SCALING_ENABLED=true
HIGH_CONTRAST_SUPPORT=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Bundle Configuration
HERMES_ENABLED=true
TURBO_MODULES_ENABLED=false
FABRIC_ENABLED=false

# Memory Management
MAX_MEMORY_USAGE=512MB
IMAGE_CACHE_LIMIT=100
LIST_ITEM_BUFFER=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels
LOG_LEVEL=info
FILE_LOGGING_ENABLED=true
REMOTE_LOGGING_ENABLED=false

# Log Rotation
MAX_LOG_SIZE=10MB
MAX_LOG_FILES=5
LOG_RETENTION_DAYS=7

# =============================================================================
# DEVICE PERMISSIONS
# =============================================================================

# Required Permissions
CAMERA_PERMISSION_REQUIRED=true
BIOMETRIC_PERMISSION_REQUIRED=true
STORAGE_PERMISSION_REQUIRED=true
NETWORK_PERMISSION_REQUIRED=true

# Optional Permissions
LOCATION_PERMISSION_OPTIONAL=false
CONTACTS_PERMISSION_OPTIONAL=false
NOTIFICATIONS_PERMISSION_OPTIONAL=true

# =============================================================================
# BUSINESS LOGIC CONFIGURATION
# =============================================================================

# Visitor Management
MAX_VISITORS_PER_DAY=1000
VISITOR_SESSION_TIMEOUT=14400000
AUTO_CHECKOUT_ENABLED=true
AUTO_CHECKOUT_HOURS=8

# Access Control
MAX_ACCESS_ATTEMPTS=3
ACCESS_LOCKOUT_DURATION=300000
SECURITY_ALERT_THRESHOLD=5

# Validation
BIOMETRIC_MATCH_THRESHOLD=0.8
FACE_RECOGNITION_CONFIDENCE=0.85
QR_CODE_EXPIRATION=300000

# =============================================================================
# REGIONAL SETTINGS
# =============================================================================

# Localization
DEFAULT_LANGUAGE=es
AVAILABLE_LANGUAGES=es,en,fr
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss
TIMEZONE=America/Mexico_City

# Currency
DEFAULT_CURRENCY=MXN
CURRENCY_SYMBOL=$

# =============================================================================
# BACKUP AND SYNC
# =============================================================================

# Data Sync
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL=300000
SYNC_ON_WIFI_ONLY=false

# Backup
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
LOCAL_BACKUP_RETENTION=7

# =============================================================================
# DEVELOPMENT TESTING
# =============================================================================

# Test Configuration
MOCK_API_ENABLED=false
MOCK_BIOMETRIC_SUCCESS=true
MOCK_CAMERA_ENABLED=false
SIMULATE_OFFLINE=false

# Demo Mode
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=demo@uniontech.com
DEMO_USER_PASSWORD=demo123

# Performance Testing
PERFORMANCE_MONITORING=true
RENDER_TRACKING=false
MEMORY_MONITORING=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Custom Headers
CUSTOM_USER_AGENT="UnionTech-Mobile/1.0.0"
API_VERSION=v1
ACCEPT_LANGUAGE=es-MX,es;q=0.9,en;q=0.8

# Rate Limiting
REQUEST_RATE_LIMIT=100
RATE_LIMIT_WINDOW=60000

# WebSocket
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_INTERVAL=5000
WS_HEARTBEAT_INTERVAL=30000

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Application Metrics
METRICS_ENABLED=true
PERFORMANCE_METRICS=true
USER_ANALYTICS=true
ERROR_TRACKING=true

# Custom Events
TRACK_USER_ACTIONS=true
TRACK_NAVIGATION=true
TRACK_PERFORMANCE=true
TRACK_ERRORS=true

# =============================================================================
# COMPLIANCE AND PRIVACY
# =============================================================================

# Privacy Settings
DATA_ANONYMIZATION=true
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true
USER_CONSENT_REQUIRED=true

# Data Retention
USER_DATA_RETENTION_DAYS=365
LOG_DATA_RETENTION_DAYS=90
ANALYTICS_DATA_RETENTION_DAYS=730

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env and configure the values for your environment
# 2. Never commit .env files to version control
# 3. Use different .env files for different environments (dev, staging, prod)
# 4. Sensitive values should be stored in secure key management systems
# 5. Boolean values should be 'true' or 'false' (lowercase)
# 6. URLs should not end with trailing slashes
# 7. Time values are in milliseconds unless otherwise specified
# 8. Size values support units: B, KB, MB, GB
