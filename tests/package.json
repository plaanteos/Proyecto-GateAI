{
  "name": "uniontech-backend-test",
  "version": "1.0.0",
  "description": "Configuración de testing para UNIONTECH Backend",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --detectOpenHandles",
    "test:e2e": "cross-env NODE_ENV=test jest --testPathPattern=e2e --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=integration --runInBand",
    "test:performance": "cross-env NODE_ENV=test jest --testPathPattern=performance --runInBand",
    "test:security": "cross-env NODE_ENV=test jest --testPathPattern=security --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/database.js",
      "!src/app.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 30000,
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true
  }
}
